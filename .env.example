# Скопировать в .env и заполнить секреты. Сам .env в git не попадает.

# --- Postgres (локально поднимается через docker-compose, порт 5460) ---
POSTGRES_URL=jdbc:postgresql://localhost:5460/edu_anyforms
POSTGRES_USER=yander
POSTGRES_PASSWORD=yander

# --- S3 (Yandex Object Storage, СВОЙ бакет, не anyforms) ---
S3_BUCKET_NAME=edu-anyforms
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CORS / Swagger ---
# Только для ответов Spring. CORS самого бакета S3 настраивается вручную
# в консоли Yandex Cloud: origins = эти же домены, methods = GET,PUT,HEAD, headers = *
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8091,https://anyforms.ru,https://edu.anyforms.ru,https://edu-anyforms.up.railway.app,https://edu-anyforms-back.up.railway.app
URL_BACK=http://localhost:8091
# Адрес фронта: из него собираются ссылки в письмах (на проде https://edu.anyforms.ru)
URL_FRONT=http://localhost:5173

# --- Письма «модуль открыт»: не больше TASKS_BATCH_SIZE писем за TASKS_FIXED_RATE_MS мс ---
# Дефолт 5 писем в минуту — под лимит бесплатного тарифа NotiSend; можно не задавать
TASKS_BATCH_SIZE=5
TASKS_FIXED_RATE_MS=60000

# --- Kinescope (видео уроков) ---
# Пусто = кнопка загрузки видео в админке вернёт понятную ошибку,
# уже загруженные видео при этом играют.
# API_TOKEN — кабинет Kinescope → настройки → API-ключи
# PARENT_ID — UUID проекта (или папки), куда падают загруженные видео
KINESCOPE_API_TOKEN=
KINESCOPE_PARENT_ID=
# Срок жизни токена воспроизведения, сек (по умолчанию 4 часа)
KINESCOPE_VIDEO_TOKEN_TTL_SECONDS=14400
# Basic-пара для колбэка DRM-авторизации: те же значения передаются
# Kinescope при регистрации колбэка (PUT https://api.kinescope.io/v1/drm/auth).
# Пусто = колбэк принимается без Basic-авторизации
KINESCOPE_DRM_CALLBACK_USER=
KINESCOPE_DRM_CALLBACK_PASSWORD=

# --- Email (NotiSend). Пусто = коды пишутся в лог вместо отправки ---
EMAIL_NOTISEND_API_KEY=
EMAIL_NOTISEND_EMAIL_ADDRESS=
EMAIL_NOTISEND_FROM_NAME=

# --- JWT (месяц; для прода заменить секрет!) ---
JWT_SECRET=
JWT_EXPIRATION_SECONDS=2592000

# --- anyforms-5: проверка оплаты курса ---
# Обязательные: без них приложение не стартует.
# SERVICE_JWT_TOKEN — один межсервисный токен на все проекты,
# то же значение, что в anyforms-5 и telegram-pusher
ANYFORMS_API_URL=https://anyforms.ru
SERVICE_JWT_TOKEN=
