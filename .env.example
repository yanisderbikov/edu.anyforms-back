# Скопировать в .env и заполнить секреты. Сам .env в git не попадает.

# --- Postgres (локально поднимается через docker-compose, порт 5460) ---
POSTGRES_URL=jdbc:postgresql://localhost:5460/edu_anyforms
POSTGRES_USER=yander
POSTGRES_PASSWORD=yander

# --- S3 (Yandex Object Storage, СВОЙ бакет, не anyforms) ---
S3_BUCKET_NAME=edu-anyforms
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CORS / Swagger ---
# Отсюда же берутся правила CORS для бакета S3 (см. S3CorsConfigurer)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8091,https://anyforms.ru,https://edu.anyforms.ru,https://edu-anyforms.up.railway.app,https://edu-anyforms-back.up.railway.app
URL_BACK=http://localhost:8091

# --- Email (NotiSend). Пусто = коды пишутся в лог вместо отправки ---
EMAIL_NOTISEND_API_KEY=
EMAIL_NOTISEND_EMAIL_ADDRESS=
EMAIL_NOTISEND_FROM_NAME=

# --- JWT (месяц; для прода заменить секрет!) ---
JWT_SECRET=
JWT_EXPIRATION_SECONDS=2592000

# --- anyforms-5: проверка оплаты курса ---
# Обязательные: без них приложение не стартует.
# SERVICE_JWT_TOKEN — один межсервисный токен на все проекты,
# то же значение, что в anyforms-5 и telegram-pusher
ANYFORMS_API_URL=https://anyforms.ru
SERVICE_JWT_TOKEN=
